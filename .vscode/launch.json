{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ARM32",
      "type": "gdb",
      "request": "launch",
      "target": "${fileDirname}/${fileBasenameNoExtension}",
      "cwd": "${fileDirname}",
      "gdbpath": "gdb-multiarch",
      "preLaunchTask": "Build",
      "autorun": ["set output-radix 16"],
      "stopAtEntry": "_start"
    },
    {
      "name": "Debug ARM32 (no build)",
      "type": "gdb",
      "request": "launch",
      "target": "${fileDirname}/${fileBasenameNoExtension}",
      "cwd": "${fileDirname}",
      "gdbpath": "gdb-multiarch",
      "autorun": ["set output-radix 16"],
      "stopAtEntry": "_start"
    }
  ]
}
